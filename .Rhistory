# ================= 3. PC5 映射 =================
raw_vals <- as.numeric(pca$loadings[5, ])
names(raw_vals) <- taxa_names(ps_final)
net_names_clean <- V(g)$name %>% str_remove("^X\\.") %>% str_remove("^X")
matched_scores <- raw_vals[net_names_clean]
if (all(is.na(matched_scores))) {
stop("错误：所有节点的 PC5 分数都未能匹配！")
} else {
message("成功匹配到 PC5 数据的节点数: ", sum(!is.na(matched_scores)))
}
# ================= 4. 写入属性 (数据准备) =================
# --- 4.1 基础属性 ---
V(g)$PC5_Score <- matched_scores
V(g)$Density_Class <- case_when(
matched_scores > 0 ~ "High_Density",
matched_scores < 0 ~ "Low_Density",
TRUE ~ "Neutral"
)
# --- 4.2 模块化 ---
set.seed(123)
use_weight <- if(!is.null(E(g)$thickness)) E(g)$thickness else NULL
wt_c <- cluster_louvain(g, weights = use_weight)
V(g)$module <- as.numeric(membership(wt_c))
# --- 4.3 物种信息 ---
tax <- as.data.frame(tax_table(ps_final))
V(g)$Phylum <- as.character(tax[net_names_clean, "Phylum"])
V(g)$Genus  <- as.character(tax[net_names_clean, "Genus"])
V(g)$Label  <- V(g)$name
# --- 4.4 颜色映射 (HEX) ---
matched_hex <- genus_colors[V(g)$Genus]
matched_hex[is.na(matched_hex)] <- genus_colors["Other"]
V(g)$color_hex <- matched_hex # 存入 HEX 以便后续使用
message("所有属性已计算完成，准备导出...")
# ================= 5. 【核心修改】导出为 GEXF (包含节点数据+颜色+边属性) =================
# A. 提取所有节点数据 (包含 PC5, module, Genus 等)
node_data_df <- igraph::as_data_frame(g, what = "vertices")
# B. 准备 Gephi 视觉颜色 (RGB + Alpha透明度)
rgb_mat <- t(col2rgb(node_data_df$color_hex))
viz_color <- cbind(rgb_mat, a = 1.0)
# C. 准备节点大小
viz_size <- rep(20, vcount(g))
# D. 【新增】提取所有边数据及属性
edge_data_df <- igraph::as_data_frame(g, what = "edges")
# 剥离出 from 和 to，剩下的就是边属性 (interaction, thickness 等)
edge_attr_df <- edge_data_df[, !(colnames(edge_data_df) %in% c("from", "to")), drop = FALSE]
# E. 导出文件
write.gexf(
nodes = data.frame(id = V(g)$name, label = V(g)$Label),
edges = edge_data_df[, c("from", "to")],
# 【关键修改 1】直接将 thickness 映射为 Gephi 的默认边权重 (Weight)
edgesWeight = edge_data_df$thickness,
# 【关键修改 2】nodesAtt 保留节点属性
nodesAtt = node_data_df,
# 【关键修改 3】edgesAtt 传入边属性，保证 Positive/Negative 成功导入
edgesAtt = edge_attr_df,
nodesVizAtt = list(
color = viz_color,
size = viz_size
),
output = "network_perfect111_color.gexf"
)
message("导出成功！请在 Gephi 中打开 'network_perfect111_color.gexf'。")
message("1. 节点颜色会自动显示。")
message("2. 边的粗细已自动映射为 Gephi 的权重 (Weight)。")
message("3. 在 Gephi 左上角的外观 (Appearance) -> 边 (Edges) -> 颜色 (Color) -> 分区 (Partition) 中，选择 'interaction' 即可为正负相互作用设置不同的颜色（例如正相关红色，负相关蓝色）。")
library(igraph)
library(dplyr)
library(stringr)
library(grDevices)
library(rgexf) # 【必需】如果没安装，请运行 install.packages("rgexf")
g <- ig_connected_safe
# ================= 0. 准备配色信息 =================
genus_colors <- readRDS("./data/dada2/microplate/top10_genus_colors.rds")
if (!"Other" %in% names(genus_colors)) {
genus_colors <- c(genus_colors, "Other" = "#DDDDDD")
}
# ================= 1. 【终极致敬】提取 SLR 算法原生的正负权重与粗细 =================
library(Matrix)
vertex_attr <- data.frame(tax_table(ps_grouped)) |> tibble::rownames_to_column("name")
# A. 提取 SLR 的 0/1 拓扑骨架
refit_net <- as.matrix(getRefit(se.slr.amgut))
# B. 获取最优 lambda 的索引
opt_ind <- getOptInd(se.slr.amgut)
# C. 【找对抽屉】直接从底层提取 SLR 的稀疏逆协方差矩阵 (icov)
raw_icov <- se.slr.amgut$est$icov[[opt_ind]]
dense_icov <- as.matrix(raw_icov)
# D. 【数学转化】将逆协方差矩阵转换为偏相关系数矩阵 (Partial Correlation)
# 数学公式：偏相关系数 = -cov2cor(逆协方差)
# 这一步是灵魂！算出来的数值：正数代表真实促进，负数代表真实竞争，绝对值就是粗细！
native_weight_mat <- -cov2cor(dense_icov)
diag(native_weight_mat) <- 0 # 去除对角线的自我相关
# E. 完美融合：用 0/1 骨架提取对应的原生权重
weighted_mat <- refit_net * native_weight_mat
# F. 构建带有原生正负权重和粗细的 igraph 对象
# 此时 weighted_mat 里有正负浮点数，adj2igraph 会自动把数值存入 E(g)$weight
ig2.mb <- adj2igraph(weighted_mat, vertex.attr = vertex_attr)
# G. 过滤孤立节点
V(ig2.mb)$degree <- igraph::degree(ig2.mb)
g <- delete_vertices(ig2.mb, V(ig2.mb)[degree < 2])
# ================= 2. 修复权重报错 =================
if(!is.null(E(g)$weight)) {
E(g)$thickness   <- abs(E(g)$weight)
E(g)$interaction <- ifelse(E(g)$weight > 0, "Positive", "Negative")
g <- delete_edge_attr(g, "weight")
}
# ================= 2.5 【新增】计算每个节点的正负连线数量 =================
# 逻辑：把网络拆成“纯正网络”和“纯负网络”，分别数连线，再把数字存回主网络
g_pos <- subgraph_from_edges(g, E(g)[interaction == "Positive"], delete.vertices = FALSE)
g_neg <- subgraph_from_edges(g, E(g)[interaction == "Negative"], delete.vertices = FALSE)
V(g)$Degree_Total    <- igraph::degree(g)
V(g)$Degree_Positive <- igraph::degree(g_pos)
V(g)$Degree_Negative <- igraph::degree(g_neg)
#正负比率 (防止分母为0，加个极小值)
V(g)$Pos_Neg_Ratio   <- V(g)$Degree_Positive / (V(g)$Degree_Negative + 0.001)
# ================= 3. PC5 映射 =================
# ... (继续你原来的第 3 步代码) ...
# ================= 3. PC5 映射 =================
raw_vals <- as.numeric(pca$loadings[5, ])
names(raw_vals) <- taxa_names(ps_final)
net_names_clean <- V(g)$name %>% str_remove("^X\\.") %>% str_remove("^X")
matched_scores <- raw_vals[net_names_clean]
if (all(is.na(matched_scores))) {
stop("错误：所有节点的 PC5 分数都未能匹配！")
} else {
message("成功匹配到 PC5 数据的节点数: ", sum(!is.na(matched_scores)))
}
# ================= 4. 写入属性 (数据准备) =================
# --- 4.1 基础属性 ---
V(g)$PC5_Score <- matched_scores
V(g)$Density_Class <- case_when(
matched_scores > 0 ~ "High_Density",
matched_scores < 0 ~ "Low_Density",
TRUE ~ "Neutral"
)
# --- 4.2 模块化 ---
set.seed(123)
use_weight <- if(!is.null(E(g)$thickness)) E(g)$thickness else NULL
wt_c <- cluster_louvain(g, weights = use_weight)
V(g)$module <- as.numeric(membership(wt_c))
# --- 4.3 物种信息 ---
tax <- as.data.frame(tax_table(ps_final))
V(g)$Phylum <- as.character(tax[net_names_clean, "Phylum"])
V(g)$Genus  <- as.character(tax[net_names_clean, "Genus"])
V(g)$Label  <- V(g)$name
# --- 4.4 颜色映射 (HEX) ---
matched_hex <- genus_colors[V(g)$Genus]
matched_hex[is.na(matched_hex)] <- genus_colors["Other"]
V(g)$color_hex <- matched_hex # 存入 HEX 以便后续使用
message("所有属性已计算完成，准备导出...")
# ================= 5. 【核心修改】导出为 GEXF (包含节点数据+颜色+边属性) =================
# A. 提取所有节点数据 (包含 PC5, module, Genus 等)
node_data_df <- igraph::as_data_frame(g, what = "vertices")
# B. 准备 Gephi 视觉颜色 (RGB + Alpha透明度)
rgb_mat <- t(col2rgb(node_data_df$color_hex))
viz_color <- cbind(rgb_mat, a = 1.0)
# C. 准备节点大小
viz_size <- rep(20, vcount(g))
# D. 【新增】提取所有边数据及属性
edge_data_df <- igraph::as_data_frame(g, what = "edges")
# 剥离出 from 和 to，剩下的就是边属性 (interaction, thickness 等)
edge_attr_df <- edge_data_df[, !(colnames(edge_data_df) %in% c("from", "to")), drop = FALSE]
# E. 导出文件
write.gexf(
nodes = data.frame(id = V(g)$name, label = V(g)$Label),
edges = edge_data_df[, c("from", "to")],
# 【关键修改 1】直接将 thickness 映射为 Gephi 的默认边权重 (Weight)
edgesWeight = edge_data_df$thickness,
# 【关键修改 2】nodesAtt 保留节点属性
nodesAtt = node_data_df,
# 【关键修改 3】edgesAtt 传入边属性，保证 Positive/Negative 成功导入
edgesAtt = edge_attr_df,
nodesVizAtt = list(
color = viz_color,
size = viz_size
),
output = "network_perfect111_color.gexf"
)
message("导出成功！请在 Gephi 中打开 'network_perfect111_color.gexf'。")
message("1. 节点颜色会自动显示。")
message("2. 边的粗细已自动映射为 Gephi 的权重 (Weight)。")
message("3. 在 Gephi 左上角的外观 (Appearance) -> 边 (Edges) -> 颜色 (Color) -> 分区 (Partition) 中，选择 'interaction' 即可为正负相互作用设置不同的颜色（例如正相关红色，负相关蓝色）。")
View(native_weight_mat)
View(dense_icov)
View(raw_icov)
raw_icov@x
library(ggVennDiagram)
library(tidyverse)
library(ggVennDiagram)
library(tidyverse)
library(ggVennDiagram)
library(tidyverse)
library(phyloseq)
library(tidytree)
library(Biostrings)
library(vegan)
library(ggtree)
library(ape)
library(scales)
library(tidyverse)
library(patchwork)
library(RColorBrewer)
library(ggVennDiagram)
library(ggpmisc)
library(export)
library(aplot)
library(cowplot)
physeq <- readRDS("./data/dada2/microplate/filtered/physeq.rds") #读取
theme_set(theme_bw())
# -------------------- 1. 聚合到 Genus 级别并计算相对丰度 --------------------
ps_genus <- tax_glom(physeq, "Genus")
ps_relabund <- transform_sample_counts(ps_genus, function(x) x / sum(x, na.rm = TRUE))
df_all <- psmelt(ps_relabund) |> as_tibble()
# -------------------- 2. 计算全局 Top10 --------------------
top10_genus_all <- df_all %>%
group_by(Genus) %>%
summarise(total = sum(Abundance), .groups="drop") %>%
slice_max(order_by = total, n = 7) %>%
pull(Genus)
top10_genus_all
# -------------------- 3. 为不同属指定配色 --------------------
top10_genus_colors = c(
"Pseudomonas" = "#332288", # 深靛蓝：高丰度主导属
"Klebsiella" = "#88CCEE", # 青蓝：凉调辅助
"Aeromonas" = "#117733", # 深绿：大地调水生关联
"Kosakonia" = "#44AA99", # 蓝绿：平衡中绿
"Stenotrophomonas" = "#CC6677", # 浅黄：温暖高光#CC6677
"Acinetobacter" = "#882255", # 橄榄绿：中性中调#882255
"Pseudoxanthomonas" = "#DDCC77", # 尘玫瑰：柔和红变体
"Ensifer" = "#999933", # 梅紫：深调内共生菌
"Rhizobium" = "#AA4499", # 洋红：鲜艳固氮菌
"Other" = "#DDDDDD" # 浅灰：背景融合
)
# 提取不同属的配色
scales::show_col(top10_genus_colors) # 输出属的配色
saveRDS(top10_genus_colors, file = "./data/dada2/microplate/top10_genus_colors.rds")
# -------------------- 4. 循环每个 carbon 作图 --------------------
df_summary <- df_all %>%
mutate(Genus = fct_relevel(fct_other(Genus, top10_genus_all), c(top10_genus_all, "Other")),
cell_num = as_factor(cell_num)) |>
group_by(carbon, cell_num, Genus) |>
summarise(Abundance = mean(Abundance), .groups = "drop")
p = ggplot(df_summary, aes(x = cell_num, y = Abundance, fill = Genus)) +
geom_bar(
stat = "identity",
position = position_fill(reverse = FALSE)
) +
facet_wrap(~carbon, nrow = 1) +
scale_y_continuous(
labels = scales::label_percent(), # 直接显示数值，不显示百分号
expand = c(0, 0)
) +
scale_fill_manual(
values = top10_genus_colors,
name = "Genus",
guide = guide_legend(reverse = F) ##图例顺序
) +
labs(
x = NULL,
y = "Relative Abundance"
) +
theme(
legend.position = "right" ,
axis.text.x = element_text( size = 10),
aspect.ratio = 1.2
)
p
#graph2ppt(p, file = "barchart.pptx",append = T)
sample_order = df_all %>%
filter(Genus == "Pseudomonas") %>%
arrange(desc(Abundance)) %>%
pull(Sample) %>%
as.character()
df_mod = df_all |>
mutate(Genus = fct_relevel(fct_other(Genus, top10_genus_all), c(top10_genus_all, "Other")),
cell_num = as_factor(cell_num)) |>
group_by(carbon, cell_num, Sample, Genus) |>
summarise(Abundance = sum(Abundance, na.rm = TRUE), .groups = "drop") |>
mutate(Sample = fct_relevel(Sample, sample_order))
#| fig-width: 10
#| fig-height: 10
p = ggplot(df_mod, aes(Sample, Abundance, fill = Genus)) +
geom_bar(stat = "identity",
position = position_fill(reverse = TRUE),
width = 1) +
scale_fill_manual(values = top10_genus_colors) +
scale_y_continuous(labels = scales::label_percent()) +
facet_wrap(~ carbon + cell_num, scales = "free_x") +
theme(
axis.ticks.x = element_blank(),
axis.text.x = element_blank(),
element_text(angle = 30, hjust = 1, size = 10)#, aspect.ratio = 1.2
)
#graph2pdf(p, file = "boxchart.pdf")
p <- ggplot(df_mod, aes(Sample, Abundance, fill = Genus)) +
geom_bar(stat = "identity",
position = position_fill(reverse = TRUE),
width = 1) +
scale_fill_manual(
values = top10_genus_colors,  # 使用我们定义的颜色
name = "Genus",
guide = guide_legend(reverse = FALSE)  # 调整图例顺序
) +
scale_y_continuous(
labels = scales::label_percent(),
expand = expansion(0, 0.01)
) +
scale_x_discrete(expand = c(0, 0) ) +
labs(
x = NULL,               # 自定义 x 轴标签
y = "Relative Abundance"     # 自定义 y 轴标签
) +
theme(
legend.position = "none",
axis.text.x = element_blank(),
axis.ticks.x = element_blank()
)
print(p)
# 1. 数据准备：确保 class 是因子 (factor) 类型，以便控制颜色顺序
sample_info = data.frame(sample_data(physeq)) |>
mutate(sampleID = fct_relevel(as.character(sampleID), sample_order),
cell_num = as_factor(cell_num),
carbon = as_factor(carbon),
class = as_factor(class)) |> # 直接使用 class
as_tibble()
metric = c("carbon", "cell_num", "class")
plots = lapply(metric, function(x){
ggplot(sample_info, aes(sampleID, x, fill = .data[[x]])) +
geom_tile() +
scale_y_discrete(expand = expansion(0,0)) +
labs(fill = x) +
theme(
legend.position = "none",
axis.title = element_blank(),
axis.text.x = element_blank(),
axis.ticks.x = element_blank())
})
plots[[1]] = plots[[1]] +
scale_fill_brewer(palette = "Set2")
plots[[2]] = plots[[2]] +
scale_fill_brewer(palette = "Reds")
# 修改 plots[[3]]：为 class 设置颜色
#plots[[3]] = plots[[3]] +
# scale_fill_manual(values = RColorBrewer::brewer.pal(4, "Paired"))
plots[[3]] = plots[[3]] +
scale_fill_manual(values = RColorBrewer::brewer.pal(12, "Paired")[c(3,4,9,10)])
carb_levels <- levels(sample_info$carbon)
carb_hex <- brewer.pal(max(length(carb_levels), 3), "Set2")[1:length(carb_levels)]
carbon_colors <- setNames(carb_hex, carb_levels)
cell_levels <- levels(sample_info$cell_num)
cell_hex <- brewer.pal(max(length(cell_levels), 3), "Reds")[1:length(cell_levels)]
cell_num_colors <- setNames(cell_hex, cell_levels)
class_levels <- levels(sample_info$class)
class_hex_source <- brewer.pal(4, "Paired")
class_hex <- class_hex_source[1:length(class_levels)]
class_colors <- setNames(class_hex, class_levels)
print("--- Carbon 颜色 ---")
print(carbon_colors)
print("--- Cell_num 颜色 ---")
print(cell_num_colors)
print("--- Class 颜色 ---")
print(class_colors)
saveRDS(list(carbon = carbon_colors, cell = cell_num_colors, class = class_colors),
file = "./data/dada2/microplate/factor_colors.rds")
#scale_fill_manual(values = my_colors$carbon)
#scale_color_manual(values = my_colors$cell)
main_panel = purrr::reduce(plots, insert_bottom) |>
insert_top(p, height = 18)
main_legend = (p +
guides(fill = guide_legend(nrow = 5, title = "Genus")) +
theme(legend.position = "right")) |>
get_legend()
metric_legends = lapply(plots, function(x) get_legend(x + theme(legend.position = "right")))
blank = ggplot() + theme_void()
legend_panel = wrap_plots(
blank,
main_legend,
metric_legends[[1]],
metric_legends[[2]],
metric_legends[[3]],
nrow = 1
) +
plot_layout(widths = c(0.3, 9, 1.8, 1.5, 1.5))
final_plot = wrap_plots(as.patchwork(main_panel), legend_panel, ncol = 1) +
plot_layout(heights = c(4,3))
final_plot
#graph2ppt(final_plot, file = "result_plot.pptx", width = 10, height = 8, append = FALSE)
#graph2png(final_plot, file = "result_plot.png", width = 10, height = 8, dpi = 300)
#graph2pdf(final_plot, file = "alpha.pdf")
#| fig-width: 10
#| fig-height: 10
p = ggplot(df_mod, aes(Sample, Abundance, fill = Genus)) +
geom_bar(stat = "identity",
position = position_fill(reverse = TRUE),
width = 1) +
scale_fill_manual(values = top10_genus_colors) +
scale_y_continuous(labels = scales::label_percent()) +
facet_wrap(~ carbon + cell_num, scales = "free_x") +
theme(
axis.ticks.x = element_blank(),
axis.text.x = element_blank(),
element_text(angle = 30, hjust = 1, size = 10)#, aspect.ratio = 1.2
)
p
